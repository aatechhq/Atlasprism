# N-ATLAS inference service - copy to .env and fill in. Never commit a real key.

# Bearer key clients must present. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_API_KEY=

# Hugging Face token with access to the gated model.
HF_TOKEN=

MODEL_ID=NCAIR1/N-ATLaS
LOAD_IN_4BIT=1
MAX_NEW_TOKENS=256
ALLOW_CPU=0
PRELOAD=1

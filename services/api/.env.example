# ATLAS Prism API - example environment. COPY to .env and fill in.
# NEVER commit a real .env. No real credential belongs in this file.

# --- Database ---
# This deployment uses managed Postgres (Neon). Take the pooled connection
# string from the Neon console and keep `sslmode=require`. A local Postgres
# works too: postgresql+psycopg://prism:prism@localhost:5432/atlas_prism
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require

# --- Testing ---
# Dedicated database for the pytest suite. REQUIRED when DATABASE_URL points
# at managed Postgres (Neon): the suite otherwise tries CREATE/DROP DATABASE
# against your production host, which a pooled endpoint refuses. Point this at
# a separate database or a Neon branch. Leave empty only for a local Postgres
# you own, where the suite creates and drops `atlas_prism_test` itself.
TEST_DATABASE_URL=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRE_MINUTES=720
# Seeded admin for the single-organization release (PRD 3 / build path 3).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-any-deployment

# Use "neon" in deployed environments. "local" preserves the legacy
# password/JWT route for tests and controlled migration only.
AUTH_MODE=local
NEON_AUTH_JWKS_URL=https://YOUR-NEON-AUTH-HOST/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://YOUR-NEON-AUTH-HOST/neondb/auth
NEON_AUTH_AUDIENCE=https://YOUR-NEON-AUTH-HOST

# --- CORS ---
# Browser origins allowed to call this API. Comma-separated, no trailing
# slash. A deployed frontend MUST be listed here or the browser blocks every
# request before it reaches a route.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://atlasprism.aatech.ng

# --- N-ATLAS gateway (PRD 7) ---
# Documented gateway base URL. No trailing slash.
NATLAS_BASE_URL=https://kambah123--natlas-serve-natlasservice-serve.modal.run
# Bearer key for the gateway. LEAVE EMPTY if you do not have one:
# the API then reports connections as blocked rather than faking success.
NATLAS_API_KEY=
NATLAS_MODEL_ID=NCAIR1/N-ATLaS
# Colab on a T4 measures ~8s per generation; a cold first call is slower.
# Raise this to 120000 when serving from a notebook.
NATLAS_TIMEOUT_MS=60000
# SSRF guard: only these hosts may ever be called for inference.
# Comma-separated. A connection endpoint outside this list is rejected --
# that is the guard working, not a bug. When you move to a Colab tunnel, BOTH
# this and NATLAS_BASE_URL must be updated to the new tunnel host.
NATLAS_ALLOWED_HOSTS=kambah123--natlas-serve-natlasservice-serve.modal.run

# --- Run execution bounds (cost/runaway protection) ---
RUN_MAX_CONCURRENCY=2
RUN_MAX_CASES=200
RUN_MAX_REPEATS=5

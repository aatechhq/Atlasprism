# ATLAS Prism API - example environment. COPY to .env and fill in.
# NEVER commit a real .env. No real credential belongs in this file.

# --- Database ---
# Local docker-compose default; change for deployment.
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:55433/atlas_prism

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRE_MINUTES=720
# Seeded admin for the single-organization release (PRD 3 / build path 3).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-any-deployment

# --- N-ATLAS gateway (PRD 7) ---
# Documented gateway base URL. No trailing slash.
NATLAS_BASE_URL=https://kambah123--natlas-serve-natlasservice-serve.modal.run
# Bearer key for the gateway. LEAVE EMPTY if you do not have one:
# the API then reports connections as blocked rather than faking success.
NATLAS_API_KEY=
NATLAS_MODEL_ID=NCAIR1/N-ATLaS
NATLAS_TIMEOUT_MS=60000
# SSRF guard: only these hosts may ever be called for inference.
# Comma-separated. A connection endpoint outside this list is rejected.
NATLAS_ALLOWED_HOSTS=kambah123--natlas-serve-natlasservice-serve.modal.run

# --- Run execution bounds (cost/runaway protection) ---
RUN_MAX_CONCURRENCY=2
RUN_MAX_CASES=200
RUN_MAX_REPEATS=5

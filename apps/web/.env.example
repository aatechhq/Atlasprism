# Base URL of the Prism API, including the /api/v1 prefix.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time -- they are NOT read at runtime. Changing this requires a full rebuild
# (`npm run cf:deploy`); redeploying the existing build changes nothing.
#
# A deployed site served over HTTPS CANNOT call http://localhost -- the browser
# blocks it as mixed content. For the deployed Worker this must be an HTTPS URL
# the visitor's browser can actually reach, and that origin must appear in the
# API's CORS_ALLOW_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-only S3-compatible storage. Never prefix these with NEXT_PUBLIC_.
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint.example
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-2

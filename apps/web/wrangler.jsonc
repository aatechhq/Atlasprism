{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlasprism",
  "main": ".open-next/worker.js",
  "routes": [
    { "pattern": "atlasprism.aatech.ng", "custom_domain": true }
  ],
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-round-queen-b51gksll.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
